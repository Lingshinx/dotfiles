alias ll = ^eza --icons --time-style=relative --long
alias l = ^eza --icons --time-style=relative
alias la = ^eza --icons --time-style=relative --all

alias lazygif = ^lazygit --git-dir=($env.HOME)/.dotfiles/ --work-tree=($env.HOME)
alias congif = ^git --git-dir=($env.HOME)/.dotfiles/ --work-tree=($env.HOME)
