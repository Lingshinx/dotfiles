#!/usr/bin/env -S nu -n --no-std-lib

def main [] {
  let items = (^busctl --user
    get-property
    org.kde.StatusNotifierWatcher
    /StatusNotifierWatcher
    org.kde.StatusNotifierWatcher
    RegisteredStatusNotifierItems)
  | str replace --regex '^as \d ' ''
  | split row --regex '\s+'
  | str replace --regex --all '^"|"$' ''
  | each { split row '/' | get 0 }

  let users = ^busctl --user list
  | detect columns
  | where PROCESS == qq | get NAME

  let dest = $items | intersect $users
  if ($dest | is-empty) {
    /bin/linuxqq
  } else {
    ^busctl --user call ...$dest /StatusNotifierItem org.kde.StatusNotifierItem Activate ii 0 0
  }
}
